# Copy to .env (git-ignored).


# Gemini chat. Either set a Vertex AI API key...
# VERTEX_API_KEY=your-vertex-api-key
# ...or use a project with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3-flash-preview

# Optional: store console tickets (PII-masked) in Cloud Storage. Bucket must already exist.
# Auth: gcloud auth application-default login (API keys do not work for Storage).
# GCS_BUCKET=your-bucket-name
# GCS_PREFIX=tickets
# GCS_STORE_RAW=false

# Optional: pseudonymous client registry in BigQuery (dataset/table/view are created on first use).
# CLIENT_ID_SALT is the secret behind client ids: generate once, keep it stable, never commit it.
#   python -c "import secrets; print(secrets.token_hex(32))"
# BQ_DATASET=sentineldesk
# BQ_LOCATION=US
# CLIENT_ID_SALT=

